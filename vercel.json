{
  "regions": ["fra1"],
  "functions": {
    "api/cron.js": { "maxDuration": 120 },
    "api/sync.js": { "maxDuration": 300 },
    "api/connect-token.js": { "maxDuration": 60 },
    "api/auth/meta/[action].js": { "maxDuration": 60 },
    "api/insights.js": { "maxDuration": 60 },
    "api/import-media.js": { "maxDuration": 120 }
  },
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ]}
  ],
  "rewrites": [{ "source": "/", "destination": "/index.html" }]
}
